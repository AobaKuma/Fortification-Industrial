<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef ParentName="FT_MGNest_Common" Name="FT_MGNest" Abstract="True">
        <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
        <statBases>
            <Flammability>0</Flammability>
            <AimingAccuracy>1.0</AimingAccuracy>
        </statBases>
        <comps>
            <li Class="CombatExtended.CompProperties_FireArc">
                <spanRange>10~360</spanRange>
                <maxSpanDeviation>180</maxSpanDeviation>
            </li>
        </comps>
        <modExtensions>
            <li Class="CombatExtended.NonSnapTurretExtension">
                <speed>2</speed>
                <angleWeightMultiplier>2</angleWeightMultiplier>
            </li>
        </modExtensions>
        <fillPercent>0.85</fillPercent>
        <building>
            <turretBurstCooldownTime>1.0</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_GarrisonBunker_Common">
        <defName>FT_Turret_GarrisonBunker</defName>
        <thingClass>FortifiedCE.Building_TurretCapacityCE</thingClass>
        <comps>
            <li Class="CombatExtended.CompProperties_FireArc">
                <spanRange>10~360</spanRange>
                <maxSpanDeviation>180</maxSpanDeviation>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerL_Common">
        <defName>FT_Turret_BunkerL</defName>
        <description>An automatic turret equipped with a full powered cartridge machine gun, encased within a basic defensive position. Constructed from leathery materials. \nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerM_Common">
        <defName>FT_Turret_BunkerM</defName>
        <description>An automatic turret equipped with a full powered cartridge machine gun, encased within a reinforced defensive position. Constructed from metallic materials. \nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerC_Common">
        <defName>FT_Turret_BunkerC</defName>
        <description>An automatic turret equipped with a full powered cartridge machine gun, encased within a reinforced defensive position. Constructed from stone materials.\nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerF_Common">
        <defName>FT_Turret_BunkerF</defName>
        <description>An automatic turret equipped with a full powered cartridge machine gun, encased within a basic defensive position. Constructed from fabric materials. Its dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Gun_MG_Common">
        <defName>FT_Gun_MG</defName>
        <label>medium turret gun</label>
        <description>Full powered cartridge automated gun inside a defensive structure.</description>
        <statBases>
            <SightsEfficiency>1</SightsEfficiency>
            <ShotSpread>0.05</ShotSpread>
            <SwayFactor>0.90</SwayFactor>
            <RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
        </statBases>
        <weaponTags>
            <li>TurretGun</li>
        </weaponTags>
        <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
                <recoilAmount>0.7</recoilAmount>
                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
                <warmupTime>1.62</warmupTime>
                <range>55</range>
                <ticksBetweenBurstShots>6</ticksBetweenBurstShots>
                <burstShotCount>10</burstShotCount>
                <soundCast>GunShotA</soundCast>
                <soundCastTail>GunTail_Medium</soundCastTail>
                <muzzleFlashScale>6</muzzleFlashScale>
                <recoilPattern>Mounted</recoilPattern>
            </li>
        </verbs>
        <comps>
            <li Class="CombatExtended.CompProperties_AmmoUser">
                <magazineSize>160</magazineSize>
                <reloadTime>7.8</reloadTime>
                <ammoSet>AmmoSet_762x51mmNATO</ammoSet>
            </li>
            <li Class="CombatExtended.CompProperties_FireModes">
                <aiAimMode>AimedShot</aiAimMode>
                <aimedBurstShotCount>4</aimedBurstShotCount>
                <noSingleShot>true</noSingleShot>
            </li>
        </comps>
    </ThingDef>
</Defs>