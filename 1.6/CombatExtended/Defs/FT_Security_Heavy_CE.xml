<?xml version="1.0" encoding="utf-8"?>

<Defs>

	<!--================噴煙者================-->

	<ThingDef ParentName="FT_TurretHexMortar_Common">
		<defName>FT_TurretHexMortar</defName>
		<label>multi-barrel rocket launcher</label>
		<description>A manned, stationary rocket artillery system for indirect saturation fire. Launches short, high-dispersion rocket salvos.</description>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<fillPercent>0.85</fillPercent>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<comps>
			<li MayRequireAnyOf="oskarpotocki.vanillafactionsexpanded.core,oskarpotocki.vanillafactionsexpanded.core_steam" Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
				<randomGraphics>
					<li>InfantryTurret/FT_HexMortarBase</li>
					<li>InfantryTurret/FT_HexMortarBase_Sec</li>
					<!--<li>FT_ConcreteArtilleryBase/TurretArtillery_Base_Heavy</li>-->
					<li>FT_ConcreteArtilleryBase/TurretArtillery_Base_Wheel_Sec</li>
				</randomGraphics>
			</li>
			<li Class="CombatExtended.CompProperties_FireArc">
				<spanRange>10~180</spanRange>
				<maxSpanDeviation>180</maxSpanDeviation>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.583</speed>
				<angleWeightMultiplier>2</angleWeightMultiplier>
			</li>
			<li Class="Fortified.InfoDisplayExtension">
				<infos>
					<li>FT_Info_Suppression</li>
				</infos>
			</li>
		</modExtensions>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<statBases>
			<MaxHitPoints>1000</MaxHitPoints>
			<Flammability>0</Flammability>
			<Bulk>1500</Bulk>
			<Mass>510</Mass>
		</statBases>
		<building>
			<turretBurstWarmupTime>3.25</turretBurstWarmupTime>
			<turretBurstCooldownTime>1</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
	</ThingDef>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>FT_Gun_TurretHexMortar</defName>
		<label>multi-barrel rocket launcher</label>
		<description>A multi-barreled rocket artillery launcher, arranged for rapid salvo fire.</description>
		<soundInteract>Artillery_ShellLoaded</soundInteract>
		<recoilPower>6</recoilPower>
		<graphicData>
			<texPath>InfantryTurret/FT_HexMortarGun</texPath>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<statBases>
			<RangedWeapon_Cooldown>0.5</RangedWeapon_Cooldown>
			<SightsEfficiency>1</SightsEfficiency>
			<ShotSpread>5.5</ShotSpread>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
		</weaponTags>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass><!--射角最高45度-->
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<hasStandardCommand>true</hasStandardCommand>
				<requireLineOfSight>false</requireLineOfSight>
				<defaultProjectile>Bullet_FT_15cmNebelwerfer_HE_directfire</defaultProjectile>
				<warmupTime>3.25</warmupTime>
				<minRange>29.9</minRange>
				<range>1000</range>
				<burstShotCount>6</burstShotCount>
				<ticksBetweenBurstShots>70</ticksBetweenBurstShots>
				<soundCast>FT_NebelShot</soundCast>
				<muzzleFlashScale>39</muzzleFlashScale>
				<!-- <circularError>1</circularError> -->
				<indirectFirePenalty>0.2</indirectFirePenalty>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>6</magazineSize>
				<reloadOneAtATime>true</reloadOneAtATime>
				<reloadTime>2.5</reloadTime>
				<ammoSet>AmmoSet_FT_15cmNebelwerfer_directfire</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>3</aimedBurstShotCount>
				<aiUseBurstMode>true</aiUseBurstMode>
			</li>
			<!--<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>20</li>
					<li>30</li>
					<li>40</li>
					<li>50</li>
					<li>55</li>
				</chargeSpeeds>
			</li>-->
			<li Class="Fortified.CompProperties_CastFlecker"> <!-- 尾煙-->
				<fleck>DustPuffThick</fleck>
				<burstAmount>10</burstAmount>
				<burstSway>60</burstSway>
				<burstAngle>180</burstAngle>
				<fleckSizeRange>(3,5)</fleckSizeRange>
				<burstSpeedRange>(1,2)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<onGroundOverride>true</onGroundOverride>
			</li>
			<li Class="Fortified.CompProperties_CastFlecker"><!-- 噴火-->
				<fleck>DustPuffThick</fleck>
				<burstAmount>10</burstAmount>
				<burstSway>70</burstSway>
				<burstAngle>180</burstAngle>
				<fleckSizeRange>(3,5)</fleckSizeRange>
				<burstSpeedRange>(0.2,0.5)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<rangeScaleFactor>(1,0.1)</rangeScaleFactor>
				<onGroundOverride>true</onGroundOverride>
			</li>
			<li Class="Fortified.CompProperties_CastFlecker"><!-- 揚塵-->
				<fleck>DustPuff</fleck>
				<burstAmount>15</burstAmount>
				<burstSway>30</burstSway>
				<burstAngle>0</burstAngle>
				<fleckSizeRange>(1,2)</fleckSizeRange>
				<burstSpeedRange>(-1.2,-0.7)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<onGroundOverride>true</onGroundOverride>
			</li>
		</comps>
		<modExtensions/>
	</ThingDef>

	<ThingDef ParentName="FT_TurretPrince_Common">
		<defName>FT_TurretPrince</defName>
		<description>A lightweight 105 mm howitzer for indirect fire at extended ranges. Due to the high muzzle velocity of the weapon system, it has a fairly large minimum range. \n\nDesignated the NK-33L “Prince”, it was developed by Interstellar Industries Complex Nara where mobility and precision are needed in uneven, difficult terrain.</description>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
		<fillPercent>0.85</fillPercent>
		<comps>
			<li MayRequireAnyOf="oskarpotocki.vanillafactionsexpanded.core,oskarpotocki.vanillafactionsexpanded.core_steam" Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
				<randomGraphics>
					<li>InfantryTurret/FT_HexMortarBase</li>
					<li>InfantryTurret/FT_HexMortarBase_Sec</li>
					<!--<li>FT_ConcreteArtilleryBase/TurretArtillery_Base_Heavy</li>-->
					<li>FT_ConcreteArtilleryBase/TurretArtillery_Base_Wheel_Sec</li>
				</randomGraphics>
			</li>
			<li Class="CombatExtended.CompProperties_FireArc">
				<spanRange>10~60</spanRange>
				<maxSpanDeviation>135</maxSpanDeviation>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.155</speed>
				<angleWeightMultiplier>2</angleWeightMultiplier>
			</li>
			<li Class="Fortified.InfoDisplayExtension">
				<infos>
					<li>FT_Info_Suppression</li>
				</infos>
			</li>
		</modExtensions>
		<statBases>
			<Bulk>2500</Bulk>
			<Mass>7154</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>550</Steel>
		</costList>
		<building>
			<turretBurstCooldownTime>1.0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
	</ThingDef>

	<ThingDef ParentName="FT_Gun_TurretPrince_Common">
		<defName>FT_Gun_TurretPrince</defName>
		<label>105mm howitzer</label>
		<description>Artillery cannon chambered for 105mm howitzer shells.</description>
		<graphicData>
			<drawOffset>(5,0,0)</drawOffset>
		</graphicData>
		<statBases>
			<RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown>
			<SightsEfficiency>1.0</SightsEfficiency>
		</statBases>
		<weaponTags>
			<li>TurretGun</li>
			<li>Artillery_BaseDestroyer</li>
		</weaponTags>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<hasStandardCommand>true</hasStandardCommand>
				<requireLineOfSight>false</requireLineOfSight>
				<defaultProjectile>Bullet_FT_105mmHowitzerShell_HE</defaultProjectile>
				<warmupTime>4</warmupTime>
				<minRange>48</minRange>
				<range>1000</range>
				<burstShotCount>1</burstShotCount>
				<soundCast>FT_CannonLaunchB</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<circularError>1</circularError>
				<indirectFirePenalty>0.27</indirectFirePenalty>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
				<!--<ignorePartialLoSBlocker>true</ignorePartialLoSBlocker>-->
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_FT_105mmHowitzerShell</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds><!--105mm大约4种尺寸发射药包--><!--弹速下限30-->
					<li>50</li><!--S-->
					<li>80</li><!--M-->
					<li>110</li><!--L-->
					<li>140</li><!--XL-->
				</chargeSpeeds>
			</li>
			<li Class="Fortified.CompProperties_CastFlecker">
				<fleck>DustPuffThick</fleck>
				<burstAmount>10</burstAmount>
				<burstSway>110</burstSway>
				<burstAngle>180</burstAngle>
				<fleckSizeRange>(3,5)</fleckSizeRange>
				<burstSpeedRange>(0.2,0.5)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<onGroundOverride>true</onGroundOverride>
			</li>
			<li Class="Fortified.CompProperties_CastFlecker">
				<fleck>DustPuffThick</fleck>
				<burstAmount>10</burstAmount>
				<burstSway>70</burstSway>
				<burstAngle>180</burstAngle>
				<fleckSizeRange>(3,5)</fleckSizeRange>
				<burstSpeedRange>(0.2,0.5)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<rangeScaleFactor>(1,0.1)</rangeScaleFactor>
				<onGroundOverride>true</onGroundOverride>
			</li>
			<li Class="Fortified.CompProperties_CastFlecker">
				<fleck>DustPuff</fleck>
				<burstAmount>15</burstAmount>
				<burstSway>30</burstSway>
				<burstAngle>0</burstAngle>
				<fleckSizeRange>(1,2)</fleckSizeRange>
				<burstSpeedRange>(-1.2,-0.7)</burstSpeedRange>
				<burstOffsetRange>(2,6)</burstOffsetRange>
				<onGroundOverride>true</onGroundOverride>
			</li>
		</comps>
		<modExtensions/>
	</ThingDef>


	<ThingDef ParentName="FT_TurretEmpero_Common">
		<defName>FT_TurretEmpero</defName>
		<label>heavy howitzer</label>
		<description>A heavy artillery piece for indirect fire at extreme ranges. Due to the very high muzzle velocity of the weapon system, it has a large minimum range. \n\nThe 155 mm howitzer NK-30 “Empero” is a reliable artillery system developed by Interstellar Industries Complex Nara to provide support for pre-industrial worlds unable to withstand mechanoid invasions.</description>
		<interactionCellOffset>(0,0,-2)</interactionCellOffset>
		<fillPercent>0.85</fillPercent>
		<comps>
			<li Class="CombatExtended.CompProperties_FireArc">
				<spanRange>10~60</spanRange>
				<maxSpanDeviation>135</maxSpanDeviation>
			</li>
		</comps>
		<modExtensions>
			<li Class="CombatExtended.NonSnapTurretExtension">
				<speed>0.113</speed>
				<angleWeightMultiplier>2</angleWeightMultiplier>
			</li>
			<li Class="Fortified.InfoDisplayExtension">
				<infos>
					<li>FT_Info_Suppression</li>
				</infos>
			</li>
		</modExtensions>
		<statBases>
			<Bulk>5000</Bulk>
			<Mass>13880</Mass>
			<Flammability>0</Flammability>
		</statBases>
		<costList>
			<Steel>600</Steel>
		</costList>
		<building>
			<turretBurstWarmupTime>4.0</turretBurstWarmupTime>
			<turretBurstCooldownTime>1.0</turretBurstCooldownTime>
			<spawnedConceptLearnOpportunity>CE_MortarDirectFire</spawnedConceptLearnOpportunity>
		</building>
	</ThingDef>

