    <!-- 單裝防空炮 -->
    <ThingDef ParentName="FT_TurretAA_Common">
        <defName>FT_TurretAA</defName>
        <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
        <statBases>   <!--================血量與重量工作量================-->
            <MaxHitPoints>1000</MaxHitPoints>
            <Flammability>0</Flammability>
            <Bulk>1000</Bulk>
            <Mass>450</Mass>
        </statBases>
        <comps>
            <li MayRequireAnyOf="oskarpotocki.vanillafactionsexpanded.core,oskarpotocki.vanillafactionsexpanded.core_steam" Class="VEF.Buildings.CompProperties_RandomBuildingGraphic">
                <randomGraphics>
                    <li>ATGun/FT_AntiAirGun_Base</li>
                    <li>ATGun/FT_AntiTankGun_Base</li>
                    <li>ATGun/FT_AntiTankGun_Base_Sec</li>
                    <li>FT_ConcreteArtilleryBase/TurretArtillery_Base_AA</li>
                </randomGraphics>
            </li>
            <li Class="CombatExtended.CompProperties_FireArc">
                <spanRange>10~360</spanRange>
                <maxSpanDeviation>180</maxSpanDeviation>
            </li>
        </comps>
        <modExtensions>
            <li Class="CombatExtended.NonSnapTurretExtension">
                <speed>0.75</speed><!--1=60度/秒-->
                <angleWeightMultiplier>2</angleWeightMultiplier>
            </li>
        </modExtensions>
        <placeWorkers>
            <li>PlaceWorker_TurretTop</li>
            <li>PlaceWorker_ShowTurretRadius</li>
        </placeWorkers>
        <building>
            <turretBurstWarmupTime>0.62</turretBurstWarmupTime>   <!--================冷卻與瞄準時間================-->
            <turretBurstCooldownTime>0.14</turretBurstCooldownTime>
        </building>
        <costList>
            <Steel>425</Steel>
            <!--<ReinforcedBarrel>1</ReinforcedBarrel>-->
        </costList>
        <costListForDifficulty>
            <difficultyVar>classicMortars</difficultyVar>
            <invert>true</invert>
            <costList>
                <Steel>350</Steel>
                <ComponentIndustrial>5</ComponentIndustrial>
                <ReinforcedBarrel>1</ReinforcedBarrel>
            </costList>
        </costListForDifficulty>
    </ThingDef>

    <ThingDef ParentName="FT_Gun_TurretAA_Common">
        <defName>FT_Gun_TurretAA</defName>
        <label>anti-air gun</label>
        <description>A 20mm autocannon mounted on a stationary emplacement.</description>
        <statBases>
            <RangedWeapon_Cooldown>0.14</RangedWeapon_Cooldown>
            <SightsEfficiency>2.18</SightsEfficiency>
            <ShotSpread>0.01</ShotSpread>
            <SwayFactor>1.38</SwayFactor>
        </statBases>
        <weaponTags>
            <li>TurretGun</li>
        </weaponTags>
        <verbs>
            <li Class="CombatExtended.VerbPropertiesCE">
                <recoilAmount>0.28</recoilAmount>
                <verbClass>CombatExtended.Verb_ShootCE</verbClass>
                <hasStandardCommand>true</hasStandardCommand>
                <defaultProjectile>Bullet_20x138mmB_AP</defaultProjectile>
                <warmupTime>0.62</warmupTime>
                <minRange>3.9</minRange>
                <range>90</range>
                <burstShotCount>4</burstShotCount>
                <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
                <soundCast>Shot_Autocannon</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
                <recoilPattern>Mounted</recoilPattern>
            </li>
        </verbs>
        <comps>
            <li Class="CombatExtended.CompProperties_AmmoUser">
                <magazineSize>20</magazineSize>
                <reloadTime>2</reloadTime>
                <ammoSet>AmmoSet_20x138mmB</ammoSet>
            </li>
            <li Class="CombatExtended.CompProperties_FireModes">
                <aiUseBurstMode>FALSE</aiUseBurstMode>
                <aiAimMode>Snapshot</aiAimMode>
                <aimedBurstShotCount>2</aimedBurstShotCount>
            </li>
        </comps>
    </ThingDef>

