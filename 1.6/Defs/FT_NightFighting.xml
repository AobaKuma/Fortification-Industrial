<?xml version="1.0" encoding="utf-8"?>

<!-- Night fighting: a powered searchlight. The flare shell lives in 1.6/Vanilla (CE has its own
     mortar ammo). Textures are placeholders. -->
<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>FT_Searchlight</defName>
        <label>searchlight</label>
        <description>A powerful electric lamp on a pedestal that floods a wide area with light, so defenders can see attackers at night.</description>
        <graphicData>
            <texPath>Placeholder/FT_Searchlight</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <size>(1,1)</size>
        <rotatable>false</rotatable>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>30</pathCost>
        <fillPercent>0.25</fillPercent>
        <tickerType>Normal</tickerType>
        <designationCategory>Security</designationCategory>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsSecurity</li>
        </thingCategories>
        <statBases>
            <MaxHitPoints>100</MaxHitPoints>
            <WorkToBuild>1200</WorkToBuild>
            <Flammability>0.5</Flammability>
            <Mass>15</Mass>
        </statBases>
        <costList>
            <Steel>60</Steel>
            <ComponentIndustrial>2</ComponentIndustrial>
        </costList>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>350</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
            <li Class="CompProperties_Glower">
                <glowRadius>20</glowRadius>
                <glowColor>(240,240,255,0)</glowColor>
            </li>
        </comps>
        <researchPrerequisites>
            <li>FT_NightFighting</li>
        </researchPrerequisites>
        <placeWorkers>
            <li>PlaceWorker_GlowRadius</li>
        </placeWorkers>
    </ThingDef>

</Defs>
