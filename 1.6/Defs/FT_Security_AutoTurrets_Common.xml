    <ThingDef Name="FT_Turret_BunkerF_Common" ParentName="FT_MGNest" Abstract="True">
        <label>auto-turret military sandbag nest</label>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Fabric</texPath>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Fabric</uiIconPath>
        <statBases>
