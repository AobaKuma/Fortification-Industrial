    </ThingDef>

    <!-- The two auto-turret nests. The four per-material versions above are kept only so
         existing buildings survive; they can no longer be built. -->
    <ThingDef ParentName="FT_MGNest">
        <defName>FT_Turret_SandbagNest</defName>
        <label>auto-turret sandbag nest</label>
        <description>An automatic machine gun behind a ring of filled sacks. Cheap and quick to put up, but it will not hold for long under fire. Built from fabric or leather, which also sets its color.\nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Fabric</texPath>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Fabric</uiIconPath>
        <statBases>
            <MaxHitPoints>350</MaxHitPoints>
            <WorkToBuild>1200</WorkToBuild>
            <Beauty>-5</Beauty>
        </statBases>
        <costStuffCount>100</costStuffCount>
        <stuffCategories>
            <li>Fabric</li>
            <li>Leathery</li>
        </stuffCategories>
        <colorPerStuff>
            <li>
                <stuff>Cloth</stuff>
                <color>(139,122,87)</color>
            </li>
            <li>
                <stuff>Synthread</stuff>
                <color>(110,114,77)</color>
            </li>
        </colorPerStuff>
    </ThingDef>

    <ThingDef ParentName="FT_MGNest">
        <defName>FT_Turret_Bunker</defName>
        <label>auto-turret bunker</label>
        <description>An automatic machine gun inside a solid emplacement. Slow to build but takes a lot of punishment. Stone and concrete give a masonry bunker, metal an armored one.\nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <graphicData>
            <!-- one texture per stuff appearance: Bricks / Concrete / Smooth = masonry, Metal = armored -->
            <texPath>MGBunker/Bunker</texPath>
            <graphicClass>Graphic_Appearances</graphicClass>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Concrete</uiIconPath>
        <statBases>
            <MaxHitPoints>500</MaxHitPoints>
            <WorkToBuild>2400</WorkToBuild>
            <Beauty>-10</Beauty>
        </statBases>
        <stuffCategories>
            <li>Stony</li>
            <li>Metallic</li>
        </stuffCategories>
    </ThingDef>

    <!-- Crewed bunker: a colonist climbs in and works the gun (framework Building_TurretCapacity,
         thingClass set per mode). No AI core and no power, but useless without a crew. -->
    <ThingDef Name="FT_Turret_GarrisonBunker_Common" ParentName="FT_MGNest" Abstract="True">
        <label>crewed machine gun bunker</label>
        <description>A machine gun inside a solid emplacement, worked by a colonist from inside. It needs no power or AI core, so it is cheaper in components than the automatic bunker and never shoots its own side by mistake, but it does nothing without a crew. The crew is protected by the structure and leaves when starving and exhausted, unless enemies are still around. Stone and concrete give a masonry bunker, metal an armored one.</description>
        <graphicData>
            <texPath>MGBunker/Bunker</texPath>
            <graphicClass>Graphic_Appearances</graphicClass>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Concrete</uiIconPath>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-2)</interactionCellOffset>
        <statBases>
            <MaxHitPoints>600</MaxHitPoints>
            <WorkToBuild>2400</WorkToBuild>
            <Beauty>-10</Beauty>
            <ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
        </statBases>
        <stuffCategories>
            <li>Stony</li>
            <li>Metallic</li>
        </stuffCategories>
        <costList Inherit="False">
            <Steel>100</Steel>
            <ComponentIndustrial>1</ComponentIndustrial>
        </costList>
        <comps Inherit="False">
            <li Class="CompProperties_Forbiddable"/>
        </comps>
        <placeWorkers>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
    </ThingDef>

    <ThingDef Name="FT_Gun_MG_Common" ParentName="BaseWeaponTurret" Abstract="True">
        <graphicData>
            <texPath>None</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
    </ThingDef>
</Defs>
