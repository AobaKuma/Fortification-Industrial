        <label>auto-turret sandbag nest (legacy)</label>
        <designationCategory IsNull="True"/>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Leathery</texPath>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Leathery</uiIconPath>
        <statBases>
            <MaxHitPoints>300</MaxHitPoints>
            <WorkToBuild>1800</WorkToBuild>
            <Beauty>-10</Beauty>
            <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
        </statBases>
        <stuffCategories>
            <li>Leathery</li>
        </stuffCategories>
    </ThingDef>

    <ThingDef Name="FT_Turret_BunkerM_Common" ParentName="FT_MGNest" Abstract="True">
        <label>auto-turret bunker (legacy)</label>
        <designationCategory IsNull="True"/>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Metal</texPath>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Metal</uiIconPath>
        <statBases>
