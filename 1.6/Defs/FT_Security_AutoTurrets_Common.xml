    <ThingDef Name="FT_Turret_BunkerF_Common" ParentName="FT_MGNest" Abstract="True">
        <label>auto-turret military sandbag nest (legacy)</label>
        <designationCategory IsNull="True"/>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Fabric</texPath>
        </graphicData>
        <uiIconPath>MGBunker/FT_MGBunker_Fabric</uiIconPath>
        <statBases>
            <MaxHitPoints>400</MaxHitPoints>
            <WorkToBuild>1800</WorkToBuild>
            <Beauty>-5</Beauty>
