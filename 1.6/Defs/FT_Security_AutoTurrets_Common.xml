<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by 1.6/Vanilla and 1.6/CombatExtended: nodes that are identical in both versions. -->
<Defs>

    <ThingDef Name="FT_MGNest_Common" ParentName="BuildingBase" Abstract="True">
        <description>An automatic turret equipped with a full powered cartridge machine gun, encased within a fortified defense structure. Its dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>MGBunker/FT_MGBunker_Leathery</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2.5,2.5)</drawSize>
            <drawOffset>(0,0,0)</drawOffset>
        </graphicData>
        <size>(3,3)</size>
        <uiIconPath>MGBunker/FT_MGBunker_Leathery</uiIconPath>
        <uiIconScale>0.90</uiIconScale>
        <altitudeLayer>Building</altitudeLayer>
        <rotatable>false</rotatable>
        <statBases>
            <MaxHitPoints>1000</MaxHitPoints>
            <WorkToBuild>1800</WorkToBuild>
            <Beauty>-20</Beauty>
            <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
        </statBases>
        <tickerType>Normal</tickerType>
        <comps>
            <li Class="CompProperties_Forbiddable"/>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>200</basePowerConsumption>
            </li>
            <li Class="CompProperties_Flickable"/>
            <li Class="CompProperties_Breakdownable"/>
        </comps>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasTooltip>true</hasTooltip>
        <costStuffCount>150</costStuffCount>
        <costList>
            <Steel>150</Steel>
            <ComponentIndustrial>3</ComponentIndustrial>
        </costList>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <designationCategory>Security</designationCategory>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
        <building>
            <combatPower>80</combatPower>
            <!-- same as a scavenger -->
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>FT_Gun_MG</turretGunDef>
        </building>
        <placeWorkers>
            <li>PlaceWorker_ShowTurretRadius</li>
        </placeWorkers>
        <researchPrerequisites>
            <li>GunTurrets</li>
        </researchPrerequisites>
    </ThingDef>

