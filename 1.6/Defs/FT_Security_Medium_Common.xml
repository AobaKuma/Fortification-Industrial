    <ThingDef Name="FT_TurretAA_Common" ParentName="FT_BaseCannonBuilding_WithShieldOrCementBase" Abstract="True">
        <label>anti-air gun</label>
        <description>A single-barrel autocannon designed for short-range air defense. Effective against low-flying aircraft and lightly armored surface targets.</description>
        <uiIconPath>ATGun/FT_AntiAirGun</uiIconPath>
        <uiIconScale>1.2</uiIconScale>
        <graphicData>
            <texPath>ATGun/FT_AntiAirGun_Base</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3.25,3.25)</drawSize>
            <drawOffset>(0,0,0)</drawOffset>
        </graphicData>
        <size>(3,3)</size>
        <interactionCellOffset>(1,0,-1)</interactionCellOffset>
        <!--操作點在右下方-->
        <statBases>
            <WorkToBuild>3000</WorkToBuild>
        </statBases>
        <building>
            <turretGunDef>FT_Gun_TurretAA</turretGunDef>
            <turretTopDrawSize>4</turretTopDrawSize>
        </building>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <costList>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <researchPrerequisites>
            <li>FT_IndustrialCannon</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef Name="FT_Gun_TurretAA_Common" ParentName="BaseWeaponTurret" Abstract="True">
        <graphicData>
            <texPath>ATGun/FT_AAGun</texPath>
        </graphicData>
        <soundInteract>Artillery_ShellLoaded</soundInteract>
        <comps>
            <li Class="Fortified.CompProperties_CastFlecker">
                <fleck>DustPuff</fleck>
                <onGroundOverride>true</onGroundOverride>
                <burstAmount>10</burstAmount>
                <burstSway>30</burstSway>
                <burstAngle>0</burstAngle>
                <fleckSizeRange>(1,2)</fleckSizeRange>
                <burstSpeedRange>(-1.2,-0.7)</burstSpeedRange>
                <burstOffsetRange>(1,3)</burstOffsetRange>
            </li>
        </comps>
    </ThingDef>

    <ThingDef Name="FT_TurretQuadAA_Common" ParentName="FT_BaseCannonBuilding_WithShieldOrCementBase" Abstract="True">
        <label>quad anti-air gun</label>
        <description>A quad-barrel anti-air autocannon designed for short-range air defense. Effective against low-flying aircraft and lightly armored surface targets.</description>
        <uiIconPath>ATGun/FT_AntiAirGun_Vierling</uiIconPath>
        <uiIconScale>1.2</uiIconScale>
        <graphicData>
            <texPath>InfantryTurret/FT_HexMortarBase</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3.25,3.25)</drawSize>
            <drawOffset>(0,0,0)</drawOffset>
        </graphicData>
        <size>(3,3)</size>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <!--操作點在下方-->
        <statBases>
            <WorkToBuild>7000</WorkToBuild>
        </statBases>
        <building>
            <turretGunDef>FT_Gun_TurretQuadAA</turretGunDef>
            <turretTopDrawSize>4</turretTopDrawSize>
        </building>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <costList>
            <ComponentIndustrial>20</ComponentIndustrial>
        </costList>
        <researchPrerequisites>
            <li>FT_IndustrialCannon</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef Name="FT_Gun_TurretQuadAA_Common" ParentName="BaseWeaponTurret" Abstract="True">
        <graphicData>
            <texPath>ATGun/FT_AAGun_Vierling</texPath>
        </graphicData>
        <soundInteract>Artillery_ShellLoaded</soundInteract>
        <comps>
            <li Class="Fortified.CompProperties_CastFlecker">
                <fleck>DustPuff</fleck>
                <onGroundOverride>true</onGroundOverride>
                <burstAmount>10</burstAmount>
                <burstSway>40</burstSway>
                <burstAngle>0</burstAngle>
                <fleckSizeRange>(1,2)</fleckSizeRange>
                <burstSpeedRange>(-1.2,-0.7)</burstSpeedRange>
