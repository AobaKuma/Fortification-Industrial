            </li>
        </comps>
        <modExtensions>
            <li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
                <def>MF_StandardMuzzleFalshTwo</def>
                <drawSize>(2,2)</drawSize>
                <offsets>
                    <li>(1.35,0.3)</li>
                    <li>(1.25,-0.3)</li>
                    <li>(1.25,0.3)</li>
                    <li>(1.35,-0.3)</li>
                </offsets>
                <isAlternately>true</isAlternately>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef Name="FT_TurretAT_Common" ParentName="FT_BaseCannonBuilding_WithShieldOrCementBase" Abstract="True">
