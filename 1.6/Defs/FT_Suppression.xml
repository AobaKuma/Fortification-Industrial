<?xml version="1.0" encoding="utf-8"?>

<!-- Suppression: machine-gun hits and heavy-shell blasts add shell shock (FT_ShellShock) to
     every pawn they hurt, friend or foe. How much is scaled by FT_ShellShockSensitivity,
     which is 1 by default and 0 for mechanoids (see Patches/FT_Suppression.xml). -->
<Defs>

    <StatDef>
        <defName>FT_ShellShockSensitivity</defName>
        <label>shell shock sensitivity</label>
        <description>A multiplier on how much shell shock this creature gets from machine-gun fire and heavy explosions. Machines feel nothing.</description>
        <category>PawnCombat</category>
        <defaultBaseValue>1</defaultBaseValue>
        <minValue>0</minValue>
        <toStringStyle>PercentZero</toStringStyle>
        <showOnMechanoids>false</showOnMechanoids>
        <displayPriorityInCategory>3900</displayPriorityInCategory>
    </StatDef>

    <!-- Same as a bullet, plus a little shell shock per hit. -->
    <DamageDef ParentName="Bullet">
        <defName>FT_Bullet_Suppressive</defName>
        <label>suppressive fire</label>
        <deathMessage>{0} has been shot to death.</deathMessage>
        <additionalHediffs>
            <li>
                <hediff>FT_ShellShock</hediff>
                <severityFixed>0.02</severityFixed>
                <victimSeverityScaling>FT_ShellShockSensitivity</victimSeverityScaling>
            </li>
        </additionalHediffs>
    </DamageDef>

    <!-- Same as a bomb, plus shell shock for everyone caught in the blast. -->
    <DamageDef ParentName="Bomb">
        <defName>FT_Bomb_Concussive</defName>
        <label>concussive blast</label>
        <deathMessage>{0} has died in an explosion.</deathMessage>
        <additionalHediffs>
            <li>
                <hediff>FT_ShellShock</hediff>
                <severityFixed>0.05</severityFixed>
                <victimSeverityScaling>FT_ShellShockSensitivity</victimSeverityScaling>
            </li>
        </additionalHediffs>
    </DamageDef>

</Defs>
