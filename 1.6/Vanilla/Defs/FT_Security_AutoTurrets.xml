<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef ParentName="FT_MGNest_Common" Name="FT_MGNest" Abstract="True">
        <thingClass>Building_TurretGun</thingClass>
        <statBases>
            <Flammability>0.0</Flammability>
        </statBases>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <outOfFuelMessage>Cannot shoot: Needs new barrel</outOfFuelMessage>
                <fuelFilter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>240</fuelCapacity>       <!-- 40 bursts -->
                <fuelMultiplier>8</fuelMultiplier> <!-- 1 steel=8ammo -->
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>              <!--重裝填設定-->
                <initialConfigurableTargetFuelLevel>240</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.1</autoRefuelPercent>
            </li>
        </comps>
        <fillPercent>0.5</fillPercent>
        <building>
            <turretBurstCooldownTime>4.8</turretBurstCooldownTime>
        </building>
        <modExtensions>
            <li Class="Fortified.InfoDisplayExtension">
                <infos>
                    <li>FT_Info_BarrelWear</li>
                    <li>FT_Info_Suppression</li>
                </infos>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_GarrisonBunker_Common">
        <defName>FT_Turret_GarrisonBunker</defName>
        <thingClass>Fortified.Building_TurretCapacity</thingClass>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <outOfFuelMessage>Cannot shoot: Needs new barrel</outOfFuelMessage>
                <fuelFilter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>240</fuelCapacity>
                <fuelMultiplier>8</fuelMultiplier>
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
                <initialConfigurableTargetFuelLevel>240</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.1</autoRefuelPercent>
            </li>
        </comps>
        <building>
            <!-- a crew fires faster than the auto nest's 4.8 s -->
            <turretBurstCooldownTime>3.5</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerL_Common">
        <defName>FT_Turret_BunkerL</defName>
        <description>An automatic turret encased within a basic defensive position. Constructed from leathery materials. \nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0.0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerM_Common">
        <defName>FT_Turret_BunkerM</defName>
        <description>An automatic turret encased within a reinforced defensive position. Constructed from metallic materials. \nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0.0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerC_Common">
        <defName>FT_Turret_BunkerC</defName>
        <description>An automatic turret encased within a reinforced defensive position. Constructed from stone materials.\nIts dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0.0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_BunkerF_Common">
        <defName>FT_Turret_BunkerF</defName>
        <description>An automatic turret encased within a basic defensive position. Constructed from fabric materials. Its dumb AI brain can't be directly controlled, so beware of friendly fire.</description>
        <statBases>
            <Flammability>0.0</Flammability>
        </statBases>
    </ThingDef>

    <ThingDef ParentName="FT_Gun_MG_Common">
        <defName>FT_Gun_MG</defName>
        <label>machine gun</label>
        <description>A fully automatic gun made to be mounted on a turret.</description>
        <statBases>
            <AccuracyTouch>0.77</AccuracyTouch>
            <AccuracyShort>0.70</AccuracyShort>
            <AccuracyMedium>0.45</AccuracyMedium>
            <AccuracyLong>0.24</AccuracyLong>
            <RangedWeapon_Cooldown>4.8</RangedWeapon_Cooldown>
            <Mass>5</Mass>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>FT_Bullet_MachineGun</defaultProjectile>
                <warmupTime>0</warmupTime>
                <range>30.9</range>
                <minRange>1.9</minRange>
                <ticksBetweenBurstShots>4</ticksBetweenBurstShots>
                <burstShotCount>6</burstShotCount>
                <soundCast>GunShotA</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
    </ThingDef>

    <!-- Mini-turret bullet stats; the hits add shell shock (FT_Suppression.xml). -->
    <ThingDef ParentName="BaseBullet">
        <defName>FT_Bullet_MachineGun</defName>
        <label>machine gun bullet</label>
        <graphicData>
            <texPath>Things/Projectile/Bullet_Small</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <projectile>
            <damageDef>FT_Bullet_Suppressive</damageDef>
            <damageAmountBase>12</damageAmountBase>
            <speed>70</speed>
        </projectile>
    </ThingDef>

</Defs>