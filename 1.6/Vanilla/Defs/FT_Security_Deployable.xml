<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef ParentName="FT_MinifiedTurret_Common" Name="FT_MinifiedTurret">
        <defName>FT_MinifiedTurret</defName>
        <comps>
            <li Class="CompProperties_UseEffect">
                <compClass>Fortified.CompMinifyToInventory</compClass>
            </li>
        </comps>
    </ThingDef>

    <ThingDef ParentName="FT_MinifiedTurretEquippable_Common" Name="FT_MinifiedTurretEquippable" Abstract="true">
        <weaponTags>
            <li>DMS_MechWeaponMedium</li>
            <li>A_SuppressWeapon</li>
        </weaponTags>
    </ThingDef>

    <ThingDef Name="FT_BaseCannonBuilding_Deployable" ParentName="FT_BaseCannonBuilding_Deployable_Common" Abstract="True">
        <building>
            <!--================冷卻與瞄準時間================-->
            <turretBurstCooldownTime>3.0</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="FT_Turret_Mortar_Common">
        <defName>FT_Turret_Mortar</defName>
        <label>infantry mortar</label>
        <description>A compact and lightweight field mortar for indirect fire. It has a shorter range compared to larger caliber equivalents, but has increased rate of fire and portability.</description>
        <!--操作點在右方-->
        <statBases>
            <MaxHitPoints>150</MaxHitPoints>
            <Flammability>0.7</Flammability>
            <WorkToBuild>100</WorkToBuild>
            <Beauty>-1</Beauty>
        </statBases>
        <inspectorTabs>
            <li>ITab_Shells</li>
        </inspectorTabs>
        <comps>
            <li Class="CompProperties_Explosive">
                <wickTicks>240</wickTicks>
                <explosiveRadius>2.9</explosiveRadius>
                <explosiveDamageType>Bomb</explosiveDamageType>
            </li>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <outOfFuelMessage>Cannot shoot: Needs new reinforced barrel</outOfFuelMessage>
                <fuelFilter>
                    <thingDefs>
                        <li>ReinforcedBarrel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelIsMortarBarrel>true</fuelIsMortarBarrel>
                <fuelCapacity>50</fuelCapacity>
                <fuelMultiplier>50</fuelMultiplier>
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <initialAllowAutoRefuel>true</initialAllowAutoRefuel>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>
                <!--重裝填設定-->
                <initialConfigurableTargetFuelLevel>25</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.1</autoRefuelPercent>
                <fuelIconPath>Things/Item/Resource/ReinforcedBarrel/ReinforcedBarrel</fuelIconPath>
            </li>
        </comps>
        <building>
            <turretBurstWarmupTime>2.0</turretBurstWarmupTime>
            <turretBurstCooldownTime>2.0</turretBurstCooldownTime>
        </building>
        <modExtensions>
            <li Class="Fortified.InfoDisplayExtension">
                <infos>
                    <li>FT_Info_ShellLoading</li>
                </infos>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="FT_Artillery_Mortar_Common">
        <defName>FT_Artillery_Mortar</defName>
        <label>mortar</label>
        <description>A powerful indirect-firing weapon with ability to rapid deploy.</description>
        <statBases>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <forceNormalTimeSpeed>false</forceNormalTimeSpeed>
                <warmupTime>2.0</warmupTime>
                <forcedMissRadius>6</forcedMissRadius>
                <forcedMissRadiusClassicMortars>10</forcedMissRadiusClassicMortars>
                <isMortar>true</isMortar>
                <requireLineOfSight>false</requireLineOfSight>
                <minRange>9.9</minRange>
                <range>100</range>
                <burstShotCount>1</burstShotCount>
                <soundCast>Mortar_LaunchA</soundCast>
                <muzzleFlashScale>16</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
            </li>
        </verbs>
        <comps>
            <li Class="CompProperties_ChangeableProjectile"/>
        </comps>
        <building>
            <fixedStorageSettings>
                <filter>
                    <categories>
                        <li>MortarShells</li>
                    </categories>
                    <disallowedThingDefs>
                        <li MayRequire="Aoba.Fortress.Industrial.NuclearDawn">FT_Shell_NuclearWarhead</li>
                        <li>Shell_AntigrainWarhead</li>
                    </disallowedThingDefs>
                </filter>
            </fixedStorageSettings>
            <defaultStorageSettings>
                <filter>
                    <categories>
                        <li>MortarShells</li>
                    </categories>
                    <disallowedThingDefs>
                        <li>Shell_Firefoam</li>
                        <li MayRequire="Aoba.Fortress.Industrial.NuclearDawn">FT_Shell_NuclearWarhead</li>
                        <li>Shell_AntigrainWarhead</li>
                    </disallowedThingDefs>
                </filter>
            </defaultStorageSettings>
        </building>
    </ThingDef>
</Defs>