                        <iconPath>UI/Ammoswitch/Shell_HE</iconPath>
                    </li>
                    <li>
                        <label>smoke</label>
                        <description>Lays a smoke screen at the target. Does no damage.</description>
                        <projectileDef>Bullet_Shell_Smoke</projectileDef>
