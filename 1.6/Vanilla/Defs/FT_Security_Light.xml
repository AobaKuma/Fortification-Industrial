<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <ThingDef Name="FT_BaseCannonBuilding" ParentName="BuildingBase" Abstract="True">
        <thingClass>Building_TurretGun</thingClass>
        <drawerType>MapMeshAndRealTime</drawerType>
        <techLevel>Industrial</techLevel>
        <graphicData>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <hasInteractionCell>True</hasInteractionCell>
        <hasTooltip>true</hasTooltip>
        <interactionCellOffset>(-1,0,-1)</interactionCellOffset>
        <stealable>false</stealable>
        <rotatable>true</rotatable>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <fillPercent>0.4</fillPercent>
        <tickerType>Normal</tickerType>
        <designationCategory>Security</designationCategory>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <statBases>
            <Beauty>-2</Beauty>
        </statBases>
        <comps>
            <li Class="CompProperties_Forbiddable" />
            <li Class="CompProperties_Mannable">
                <manWorkType>Violent</manWorkType>
            </li>
        </comps>
        <damageMultipliers>
            <li>
                <damageDef>EMP</damageDef>
                <multiplier>0</multiplier>
            </li>
            <li>
                <damageDef>Stun</damageDef>
                <multiplier>0</multiplier>
            </li>
            <li MayRequire="Ludeon.RimWorld.Biotech">
                <damageDef>MechBandShockwave</damageDef>
                <multiplier>0</multiplier>
            </li>
        </damageMultipliers>
        <placeWorkers>
            <li>PlaceWorker_TurretTop</li>
            <li>PlaceWorker_PreventInteractionSpotOverlap</li>
        </placeWorkers>
        <uiIconScale>1.1</uiIconScale>
    </ThingDef>

    <ThingDef Name="FT_BaseCannonBuilding_Mobile" ParentName="FT_BaseCannonBuilding" Abstract="True">
        <minifiedDef>MinifiedThing</minifiedDef>  <!--================可攜帶性
    ================-->
        <thingCategories>
            <li>BuildingsSecurity</li>
        </thingCategories>
        <statBases>
            <Mass>150</Mass>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <building>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretBurstWarmupTime>1.0</turretBurstWarmupTime>   <!--================冷卻與瞄準時間================-->
            <turretBurstCooldownTime>3.0</turretBurstCooldownTime>
        </building>
    </ThingDef>

    <ThingDef ParentName="FT_BaseCannonBuilding_Mobile">
        <defName>FT_Maxim4M</defName>
        <label>quad machine gun</label>
        <description>A tripod-mounted quad machine gun operated by a pawn. Provides sustained firepower and requires steel to refurbish its barrels after heavy use.</description>
        <uiIconPath>InfantryTurret/FT_QuadMaximGun_icon</uiIconPath>
        <uiIconScale>0.8</uiIconScale>
        <graphicData>
            <texPath>InfantryTurret/FT_Tripod</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.3,1.3)</drawSize>
            <drawOffset>(0,0,-0.1)</drawOffset>
        </graphicData>
        <statBases>
            <MaxHitPoints>400</MaxHitPoints>
            <Flammability>0.7</Flammability>
            <WorkToBuild>3300</WorkToBuild>
            <Mass>25</Mass>
            <Beauty>-2</Beauty>
            <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
        </statBases>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>800</fuelCapacity>
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <fuelMultiplier>8</fuelMultiplier> <!-- 1 steel=8ammo -->
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Needs new barrels</outOfFuelMessage>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>              <!--重裝填設定-->
                <initialConfigurableTargetFuelLevel>400</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.5</autoRefuelPercent>
            </li>
        </comps>
        <costList>
            <Steel>160</Steel>
            <ComponentIndustrial>16</ComponentIndustrial>
        </costList>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <building>
            <turretTopDrawSize>2</turretTopDrawSize>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>FT_Gun_QuadMG</turretGunDef>
			<turretBurstWarmupTime>0.5</turretBurstWarmupTime>
            <turretBurstCooldownTime>1.0</turretBurstCooldownTime><!--冲锋手枪0.9-->
        </building>
        <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>BlowbackOperation</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>FT_Gun_QuadMG</defName>
        <label>machine gun 4x mounted</label>
        <description>What could be better than a fully automatic machine gun mounted on a turret? Four of them!</description>
        <graphicData>
            <texPath>InfantryTurret/FT_QuadMaximGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <statBases>
            <AccuracyTouch>0.44</AccuracyTouch>
            <AccuracyShort>0.68</AccuracyShort>
            <AccuracyMedium>0.65</AccuracyMedium>
            <AccuracyLong>0.54</AccuracyLong>
            <RangedWeapon_Cooldown>1.0</RangedWeapon_Cooldown><!--冲锋手枪0.9-->
            <Mass>15</Mass>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>Bullet_MiniTurret</defaultProjectile>
                <warmupTime>0.5</warmupTime><!--防空机枪，瞄准给低点--><!--冲锋手枪0.5-->
                <range>30.9</range>
                <minRange>1.9</minRange>
                <ticksBetweenBurstShots>2</ticksBetweenBurstShots><!--特化旋转机枪1800rpm-->
                <burstShotCount>20</burstShotCount>
                <soundCast>GunShotA</soundCast>
                <soundCastTail>GunTail_Light</soundCastTail>
                <muzzleFlashScale>9</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
        <modExtensions>
            <li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
                <def>MF_StandardMuzzleFalsh</def>
                <drawSize>(0.5,0.5)</drawSize>
                <offsets>
                    <li>(0.96,0.304)</li>
                    <li>(0.96,0.125)</li>
                    <li>(0.96,-0.125)</li>
                    <li>(0.96,-0.304)</li>
                </offsets>
                <isAlternately>true</isAlternately>
            </li>
        </modExtensions>
    </ThingDef>

    <ThingDef ParentName="FT_BaseCannonBuilding_Mobile">
        <defName>FT_AutoCannon</defName>
        <label>autocannon</label>
        <description>A single barrel autocannon mounted on a tripod. Needs to be manned in order to fire. Requires steel to refurbish its barrels after heavy use.</description>
        <uiIconPath>InfantryTurret/FT_AutoCannonGun_icon</uiIconPath>
        <uiIconScale>1.2</uiIconScale>
        <graphicData>
            <texPath>InfantryTurret/FT_Tripod</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.3,1.3)</drawSize>
            <drawOffset>(0,0,-0.1)</drawOffset>
        </graphicData>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <Flammability>0.7</Flammability>
            <WorkToBuild>3300</WorkToBuild>
            <Mass>23</Mass>
            <Beauty>-2</Beauty>
            <ShootingAccuracyTurret>1.0</ShootingAccuracyTurret>
        </statBases>
        <costList>
            <Steel>120</Steel>
            <ComponentIndustrial>4</ComponentIndustrial>
        </costList>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <building>
            <turretTopDrawSize>2.5</turretTopDrawSize>
            <ai_combatDangerous>true</ai_combatDangerous>
            <turretGunDef>FT_Gun_Autocannon</turretGunDef>
			<turretBurstWarmupTime>1.0</turretBurstWarmupTime>
            <turretBurstCooldownTime>2</turretBurstCooldownTime>
        </building>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>Steel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>120</fuelCapacity>
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <fuelMultiplier>2</fuelMultiplier>
                <factorByDifficulty>true</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Needs new barrels</outOfFuelMessage>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>              <!--重裝填設定-->
                <initialConfigurableTargetFuelLevel>60</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.1</autoRefuelPercent>
            </li>
        </comps>
        <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>GasOperation</li>
        </researchPrerequisites>
    </ThingDef>
    <ThingDef ParentName="BaseWeaponTurret">
        <defName>FT_Gun_Autocannon</defName>
        <label>autocannon</label>
        <description>A self-loading large-bore cannon designed to attach to a turret.</description>
        <graphicData>
            <texPath>InfantryTurret/FT_AutoCannonGun</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(2,2)</drawSize>
        </graphicData>
        <statBases>
            <AccuracyTouch>0.70</AccuracyTouch>
            <AccuracyShort>0.90</AccuracyShort>
            <AccuracyMedium>0.83</AccuracyMedium>
            <AccuracyLong>0.75</AccuracyLong>
            <RangedWeapon_Cooldown>2</RangedWeapon_Cooldown>
            <Mass>40</Mass>
        </statBases>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
                <warmupTime>1</warmupTime><!--填0游戏中会自动变成1-->
                <minRange>1.9</minRange>
                <range>34.9</range>
                <ticksBetweenBurstShots>17</ticksBetweenBurstShots>
                <burstShotCount>5</burstShotCount>
                <soundCast>FT_AutoCannonShot</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>12</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
            </li>
        </verbs>
    </ThingDef>


    <ThingDef ParentName="FT_BaseCannonBuilding_Mobile">
        <defName>FT_RecoillessGun</defName>
        <label>recoilless gun</label>
        <description>A recoilless gun mounted on a tripod. Mainly used for hardened targets such as vehicles and armored mechs. Needs to be manned in order to fire. Requires reinforced barrels to refurbish its barrel after heavy use.</description>
        <uiIconPath>InfantryTurret/FT_RecoillessGun_icon</uiIconPath>
        <uiIconScale>1.2</uiIconScale>
        <graphicData>
            <texPath>InfantryTurret/FT_Tripod</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1.2,1.2)</drawSize>
            <drawOffset>(0,0,-0.1)</drawOffset>
        </graphicData>
        <statBases>
            <MaxHitPoints>400</MaxHitPoints>
            <Flammability>0.7</Flammability>
            <WorkToBuild>3300</WorkToBuild>
            <Mass>38</Mass>
            <Beauty>-2</Beauty>
            <ShootingAccuracyTurret>0.96</ShootingAccuracyTurret>
        </statBases>
        <comps>
            <li Class="CompProperties_Refuelable">
                <fuelLabel>Shots until barrel change</fuelLabel>
                <fuelGizmoLabel>Barrel durability</fuelGizmoLabel>
                <fuelFilter>
                    <thingDefs>
                        <li>ReinforcedBarrel</li>
                    </thingDefs>
                </fuelFilter>
                <fuelCapacity>20</fuelCapacity>    <!-- 20 burst -->
                <fuelMultiplier>20</fuelMultiplier><!-- 1 barrel=20 ammo -->
                <initialFuelPercent>1</initialFuelPercent>
                <showFuelGizmo>true</showFuelGizmo>
                <minimumFueledThreshold>1</minimumFueledThreshold>
                <factorByDifficulty>false</factorByDifficulty>
                <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
                <outOfFuelMessage>Cannot shoot: Needs new barrels</outOfFuelMessage>
                <fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
                <targetFuelLevelConfigurable>true</targetFuelLevelConfigurable>              <!--重裝填設定-->
                <initialConfigurableTargetFuelLevel>0</initialConfigurableTargetFuelLevel>
                <autoRefuelPercent>0.1</autoRefuelPercent>
            </li>
        </comps>
        <interactionCellOffset>(-1,0,-1)</interactionCellOffset>
        <costList>
            <Steel>150</Steel>
            <ReinforcedBarrel>1</ReinforcedBarrel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <building>
            <turretGunDef>FT_Gun_Recoilless</turretGunDef>
            <turretTopDrawSize>2.5</turretTopDrawSize>
            <turretBurstWarmupTime>1.0</turretBurstWarmupTime>   <!--================冷卻與瞄準時間================-->
            <turretBurstCooldownTime>5.0</turretBurstCooldownTime>
        </building>
        <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
        <researchPrerequisites>
            <li>FT_IndustrialCannon</li>
        </researchPrerequisites>
    </ThingDef>

    <ThingDef ParentName="BaseWeaponTurret">
        <defName>FT_Gun_Recoilless</defName>
        <label>recoilless cannon</label>
        <description>A Recoilless cannon designed to snipe the heavy-armed target in range.</description>
        <graphicData>
            <texPath>InfantryTurret/FT_RecoillessGun</texPath>
            <drawSize>(3,3)</drawSize>
        </graphicData>
        <soundInteract>Artillery_ShellLoaded</soundInteract>
        <statBases>
            <AccuracyTouch>0.84</AccuracyTouch>
            <AccuracyShort>0.95</AccuracyShort>
            <AccuracyMedium>0.92</AccuracyMedium>
            <AccuracyLong>0.90</AccuracyLong>
            <RangedWeapon_Cooldown>5.0</RangedWeapon_Cooldown>
            <Mass>120</Mass>
        </statBases>
        <comps>
            <li Class="Fortified.CompProperties_CastPushHeat">
                <energyPerCast>50000</energyPerCast>
            </li>
            <li Class="Fortified.CompProperties_CastFlecker"><!-- 後方揚塵-->
                <fleck>DustPuffThick</fleck>
                <burstAmount>20</burstAmount>
                <burstSway>20</burstSway>
                <burstAngle>180</burstAngle>
                <fleckSizeRange>(1,8)</fleckSizeRange>
                <burstSpeedRange>(0.5,1)</burstSpeedRange>
                <burstOffsetRange>(4,9)</burstOffsetRange>
            </li>
            <li Class="Fortified.CompProperties_CastFlecker"><!-- 向後噴-->
                <fleck>DustPuff</fleck>
                <burstAmount>10</burstAmount>
                <burstSway>45</burstSway>
                <burstAngle>0</burstAngle>
                <fleckSizeRange>(1,3)</fleckSizeRange>
                <burstSpeedRange>(-0.5,0.5)</burstSpeedRange>
                <burstOffsetRange>(2,5)</burstOffsetRange>
            </li>
            <li Class="Fortified.CompProperties_CastFlecker"><!-- 向後噴-->
                <fleck>FT_ExhaustFlame</fleck>
                <burstAmount>10</burstAmount>
                <burstSway>5</burstSway>
                <burstAngle>180</burstAngle>
                <fleckSizeRange>(1,2)</fleckSizeRange>
                <burstSpeedRange>(2,2.5)</burstSpeedRange>
                <burstOffsetRange>(2,2.5)</burstOffsetRange>
                <onGroundOverride>true</onGroundOverride>
            </li>
            <li Class="Fortified.CompProperties_CastFlecker"><!-- 向後噴-->
                <fleck>FT_ExhaustFlameGlow</fleck>
                <burstAmount>10</burstAmount>
                <burstSway>5</burstSway>
                <burstAngle>180</burstAngle>
                <fleckSizeRange>(1,2)</fleckSizeRange>
                <burstSpeedRange>(2,2.5)</burstSpeedRange>
                <burstOffsetRange>(2,2.5)</burstOffsetRange>
                <onGroundOverride>true</onGroundOverride>
            </li>
            <li Class="Fortified.CompProperties_CastFlecker"><!-- 向前-->
                <fleck>DustPuff</fleck>
                <burstAmount>10</burstAmount>
                <burstSway>5</burstSway>
                <burstAngle>180</burstAngle>
                <fleckSizeRange>(5,8)</fleckSizeRange>
                <burstSpeedRange>(1,8)</burstSpeedRange>
                <burstOffsetRange>(7,11)</burstOffsetRange>
            </li>
        </comps>
        <verbs>
            <li>
                <verbClass>Verb_Shoot</verbClass>
                <defaultProjectile>FT_Bullet_ATShell</defaultProjectile>
                <warmupTime>1</warmupTime>
                <minRange>3.9</minRange>
                <range>39.9</range>
                <burstShotCount>1</burstShotCount>
                <isMortar>true</isMortar>
                <soundCast>FT_CannonLaunchA</soundCast>
                <soundCastTail>GunTail_Heavy</soundCastTail>
                <muzzleFlashScale>25</muzzleFlashScale>
                <consumeFuelPerShot>1</consumeFuelPerShot>
                <targetParams>
                    <canTargetLocations>true</canTargetLocations>
                </targetParams>
                <ai_AvoidFriendlyFireRadius>3</ai_AvoidFriendlyFireRadius>
                <forcedMissRadius>0.1</forcedMissRadius>
            </li>
        </verbs>
    </ThingDef>
</Defs>
