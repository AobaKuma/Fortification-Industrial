    <ThingDef ParentName="FT_Gun_TurretQuadAA_Common">
        <defName>FT_Gun_TurretQuadAA</defName>
        <label>quad anti air cannon</label>
        <description>A quad mounted anti-aircraft autocannon designed to provide high-volume, short-range, and rapid-traverse air defense against low-flying strafing aircraft, but also is effective as a ground support platform.</description>
        <statBases>
